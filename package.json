{
  "name": "kidssafe",
  "version": "0.1.0",
  "private": true,
  "description": "Modulare Open-Source-Webapp für IT-Sicherheitskompetenz an Schulen",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./backend\" --filter \"./frontend\" dev",
    "dev:backend": "pnpm --filter \"./backend\" dev",
    "dev:frontend": "pnpm --filter \"./frontend\" dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "db:generate": "pnpm --filter \"./backend\" db:generate",
    "db:migrate": "pnpm --filter \"./backend\" db:migrate"
  },
  "keywords": [
    "education",
    "security",
    "pwa",
    "react",
    "nodejs",
    "typescript",
    "prototype-fund"
  ],
  "author": "Kidssafe Contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
